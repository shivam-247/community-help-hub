# Copy to an untracked environment file or configure your hosting environment.
APP_ENV=production
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./community_help_hub.db
# Browser talks to Next.js, so backend CORS can remain empty.
CORS_ORIGINS=
# Optional: same random secret in frontend/backend for trusted client-IP forwarding.
PROXY_SHARED_SECRET=
# Optional operator-only provisioning. Only a NEW account is created; existing accounts are untouched.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
# Argon2id hash only, never a plaintext password.
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Explicit development/demo flags; checkout never collects a real payment.
MOCK_CHECKOUT_ENABLED=false
DEMO_SEED_ENABLED=false
APP_ORIGIN=http://localhost:3000

# Transactional test invoices, email verification and optional paid-plan alerts.
# Render Free blocks common SMTP ports. Prefer Resend HTTPS delivery there.
# Add these privately in Render Environment, never in source control.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
RESEND_API_KEY=
# Set EMAIL_PROVIDER=resend plus EMAIL_FROM and RESEND_API_KEY for HTTPS delivery.
# EMAIL_FROM must use your provider-approved sender/domain. Vercel's shared domain
# cannot be verified as your own email-sending domain.
# SMTP remains available on hosts that permit STARTTLS SMTP.
# Invoice recipients must verify their account email before delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
